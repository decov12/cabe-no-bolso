# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta

# True em desenvolvimento, False em produção
DEBUG=True

# Deixe vazio para usar SQLite local. Em produção: postgres://usuario:senha@host:5432/banco
DATABASE_URL=

# Hosts separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do frontend separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Chaves das APIs externas
SERPAPI_KEY=sua-chave-da-serpapi
GEMINI_API_KEY=sua-chave-do-gemini
